rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Domain validation helpers
    function isValidHouse(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.type is string && (data.type == 'ኪራይ' || data.type == 'ሽያጭ') &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.location is string && data.location.size() >= 2 && data.location.size() <= 100 &&
             data.priceDisplay is string && data.priceDisplay.size() >= 1 && data.priceDisplay.size() <= 60 &&
             data.priceAmount is int && data.priceAmount >= 0 && data.priceAmount <= 1000000000 &&
             data.bedrooms is int && data.bedrooms >= 0 && data.bedrooms <= 20 &&
             data.areaSqm is int && data.areaSqm >= 0 && data.areaSqm <= 50000 &&
             data.description is string && data.description.size() <= 600 &&
             data.imageKey is string && (data.imageKey in ['apartment', 'condo', 'villa', 'service']) &&
             data.status is string && (data.status in ['active', 'closed']) &&
             data.starterListing is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHouseContact(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 24 &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUnlock(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.houseId is string && isValidId(data.houseId) &&
             data.amountBirr is int && data.amountBirr == 50 &&
             data.paymentMethod is string && data.paymentMethod == 'telebirr' &&
             data.transactionRef is string && data.transactionRef.size() >= 4 && data.transactionRef.size() <= 64 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Public house listings (NO phone numbers stored here)
    match /houses/{houseId} {
      allow get: if isSignedIn() && isValidId(houseId) &&
                    (existing().status == 'active' || existing().ownerId == request.auth.uid);

      // Query Enforcer: client must filter by status == 'active' OR ownerId == request.auth.uid
      allow list: if isSignedIn() &&
                     (existing().status == 'active' || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(houseId) &&
                       isValidHouse(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().status == 'active' &&
                       incoming().keys().hasAll([
                         'ownerId', 'type', 'title', 'location', 'priceDisplay',
                         'priceAmount', 'bedrooms', 'areaSqm', 'description',
                         'imageKey', 'status', 'starterListing', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'type', 'title', 'location', 'priceDisplay',
                         'priceAmount', 'bedrooms', 'areaSqm', 'description',
                         'imageKey', 'status', 'starterListing', 'createdAt', 'updatedAt'
                       ]);

      // Terminal State Locking: closed listings cannot be edited further
      allow update: if isSignedIn() &&
                       isValidId(houseId) &&
                       isValidHouse(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       existing().status == 'active' &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().starterListing == existing().starterListing &&
                       (
                         // Action 1: Edit listing details
                         (
                           incoming().status == 'active' &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'type', 'title', 'location', 'priceDisplay', 'priceAmount',
                             'bedrooms', 'areaSqm', 'description', 'imageKey', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Mark listing as closed (rented/sold)
                         (
                           incoming().status == 'closed' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(houseId) && existing().ownerId == request.auth.uid;

      // 2. Split-collection PII: Owner phone number isolated under /houses/{houseId}/contact/private
      match /contact/{contactId} {
        allow get: if isSignedIn() &&
                      isValidId(houseId) &&
                      contactId == 'private' &&
                      (
                        existing().ownerId == request.auth.uid ||
                        exists(/databases/$(database)/documents/users/$(request.auth.uid)/unlocks/$(houseId))
                      );

        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(houseId) &&
                         contactId == 'private' &&
                         isValidHouseContact(incoming()) &&
                         incoming().ownerId == request.auth.uid &&
                         existsAfter(/databases/$(database)/documents/houses/$(houseId)) &&
                         getAfter(/databases/$(database)/documents/houses/$(houseId)).data.ownerId == request.auth.uid &&
                         incoming().keys().hasAll(['ownerId', 'phone', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['ownerId', 'phone', 'ownerName', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isValidId(houseId) &&
                         contactId == 'private' &&
                         isValidHouseContact(incoming()) &&
                         existing().ownerId == request.auth.uid &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'ownerName', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(houseId) &&
                         contactId == 'private' &&
                         existing().ownerId == request.auth.uid;
      }
    }

    // 3. Per-user immutable contact unlock receipts
    match /users/{userId}/unlocks/{houseId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(houseId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(houseId) &&
                       request.auth.uid == userId &&
                       isValidUnlock(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().houseId == houseId &&
                       exists(/databases/$(database)/documents/houses/$(houseId)) &&
                       incoming().keys().hasAll([
                         'userId', 'houseId', 'amountBirr', 'paymentMethod', 'transactionRef', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'houseId', 'amountBirr', 'paymentMethod', 'transactionRef', 'createdAt'
                       ]);

      allow update, delete: if false;
    }
  }
}
